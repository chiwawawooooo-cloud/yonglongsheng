  <style>
    :root{
      --yls-gold:#c5a66d;
      --yls-gold-dark:#a68b55;
      --yls-navy:#101d2d;
      --yls-light:#f4f7f9;
      --card-shadow:0 30px 60px rgba(0,0,0,0.12);
      --transition:all .4s cubic-bezier(.165,.84,.44,1);
      --radius:20px;
    }
    *{ box-sizing:border-box; }
    html{ scroll-behavior:smooth; }
    body{
      font-family:'Noto Sans TC',sans-serif;
      margin:0;
      background:var(--yls-light);
      color:#333;
      line-height:1.75;
    }

    nav{
      background:rgba(255,255,255,.92);
      backdrop-filter:blur(10px);
      padding:14px 8%;
      display:flex;
      justify-content:space-between;
      align-items:center;
      position:sticky;
      top:0;
      z-index:1000;
      box-shadow:0 2px 15px rgba(0,0,0,.05);
    }
    .logo{
      font-size:1.2rem;
      font-weight:900;
      color:var(--yls-navy);
      letter-spacing:3px;
      text-decoration:none;
      display:flex;
      gap:10px;
      align-items:center;
    }
    .nav-links{
      display:flex;
      gap:18px;
